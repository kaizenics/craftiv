BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

TURSO_DATABASE_URL=https://your-db-name.turso.io
TURSO_AUTH_TOKEN=replace-with-a-turso-token

OPENROUTER_API_KEY=replace-with-an-openrouter-key

RESEND_API_KEY=replace-with-a-resend-key
AUTH_EMAIL_FROM=noreply@example.com
RESEND_FROM_EMAIL=noreply@example.com

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Polar payments. sandbox and production are separate environments with their
# own dashboard, tokens and product IDs — keep POLAR_SERVER in step with them.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=replace-with-polar-organization-access-token
POLAR_PRODUCT_ID_ACTIVE=replace-with-active-product-uuid
POLAR_PRODUCT_ID_PLUS=replace-with-plus-product-uuid
POLAR_PRODUCT_ID_PRO=replace-with-pro-product-uuid
POLAR_WEBHOOK_SECRET=replace-with-webhook-secret
POLAR_SUCCESS_URL=http://localhost:3000/dashboard/settings

# Number of reverse proxies between the internet and this app. Rate limiting
# reads the client address this many entries back from the end of
# X-Forwarded-For; entries further left are client-written and ignored.
# Coolify's Traefik alone is 1. Add 1 for each extra edge (e.g. Cloudflare -> 2).
# Too low over-trusts the client and lets per-IP limits be bypassed; too high
# buckets every user under a proxy address. 0 disables IP-based limits entirely.
TRUSTED_PROXY_HOPS=1

# Optional. A header your edge sets AND overwrites on every request, e.g.
# cf-connecting-ip. When set it takes precedence over X-Forwarded-For.
# Only set this if you have confirmed the edge replaces the client's value.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
