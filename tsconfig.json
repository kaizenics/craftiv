{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["./packages/ui/*"],
      "@/db": ["./packages/db/index.ts"],
      "@/db/*": ["./packages/db/*"],
      "@/trpc": ["./packages/trpc/index.ts"],
      "@/trpc/*": ["./packages/trpc/*"],
      "@/lib/auth": ["./packages/auth.ts"],
      "@/lib/auth-client": ["./packages/auth-client.ts"],
      "@/lib/types/*": ["./packages/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
